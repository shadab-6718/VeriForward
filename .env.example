# Gemini API Key (Required for claim credibility analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model name to use (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional: Configuration weights and thresholds
# URL_WEIGHT=0.5
# CLAIM_WEIGHT=0.5
# OVERRIDE_THRESHOLD=0.85
# LOW_RISK_THRESHOLD=0.35
# HIGH_RISK_THRESHOLD=0.70
